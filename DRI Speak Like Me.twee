:: StoryScript [script]
async function loadScript(url) {
  return new Promise((resolve, reject) => {
    const script = document.createElement("script");
    script.src = url;
    script.onload = resolve;
    script.onerror = reject;
    document.head.appendChild(script);
  });
}

async function initFirebase() {
  // Load Firebase compat scripts
  await loadScript("https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js");
  await loadScript("https://www.gstatic.com/firebasejs/10.12.0/firebase-storage-compat.js");
  await loadScript("https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js");

  const firebaseConfig = {
    apiKey: "AIzaSyDzxQOQQQBk6PQwnlNzcSOlpmTHGN3XiW4",
    authDomain: "dri-speak-like-me-d6c5d.firebaseapp.com",
    projectId: "dri-speak-like-me-d6c5d",
    storageBucket: "dri-speak-like-me-d6c5d.firebasestorage.app",
    messagingSenderId: "813507703556",
    appId: "1:813507703556:web:c5418e16c8d35b93391651",
    measurementId: "G-GGPXHDVE2P"
  };

  // Initialize Firebase
  firebase.initializeApp(firebaseConfig);

  // Store globally for Twine access
  window.storage = firebase.storage();
  window.auth = firebase.auth();

  // Sign in anonymously (so Storage rules pass)
  try {
    const userCredential = await window.auth.signInAnonymously();
    console.log("Signed in anonymously:", userCredential.user.uid);
  } catch (err) {
    console.error("Auth error:", err);
  }

  console.log("Firebase ready");
}

// Call it once (e.g. StoryInit passage)
initFirebase();


// Optional: Google login (if you want it later)
window.loginWithGoogle = function () {
  const provider = new firebase.auth.GoogleAuthProvider();
  window.auth.signInWithPopup(provider)
    .then(result => {
      console.log("Logged in as:", result.user.uid);
    })
    .catch(console.error);
};

let mediaRecorder;
let recordedChunks = [];
let currentType = null;
let stream = null;
let currentBlob = null;

function sanitizeName(name) {
  return name.replace(/[^a-z0-9]/gi, "_").toLowerCase();
}

window.startRecording = async function(type) {

  currentType = type;

  const constraints = type === "video"
    ? { video: true, audio: true }
    : { audio: true };

  stream = await navigator.mediaDevices.getUserMedia(constraints);

  mediaRecorder = new MediaRecorder(stream);
  recordedChunks = [];

  mediaRecorder.ondataavailable = function(e) {
    if (e.data.size > 0) recordedChunks.push(e.data);
  };

  mediaRecorder.onstop = function() {

    currentBlob = new Blob(recordedChunks, {
      type: currentType === "video" ? "video/webm" : "audio/webm"
    });

    console.log("Blob created:", currentBlob);

    const url = URL.createObjectURL(currentBlob);

    const preview = document.getElementById("preview");

    if (currentType === "video") {
      preview.innerHTML = `<video controls width="300" src="${url}"></video>`;
    } else {
      preview.innerHTML = `<audio controls src="${url}"></audio>`;
    }

    document.getElementById("controls").style.display = "block";
    document.getElementById("uploadBtn").disabled = false;
    document.getElementById("status").innerText = "Preview your recording";

    stream.getTracks().forEach(track => track.stop());
  };

  mediaRecorder.start();

  document.getElementById("status").innerText = "Recording...";
};

window.stopRecording = function() {

  if (!mediaRecorder || mediaRecorder.state === "inactive") return;

  mediaRecorder.stop();
  document.getElementById("status").innerText = "Processing...";
};

window.uploadRecording = async function() {

  if (!window.storage) {
    console.log("Firebase not ready yet");
    document.getElementById("status").innerText =
      "Firebase not ready. Try again in a moment.";
    return;
  }

  if (!currentBlob) {
    document.getElementById("status").innerText =
      "No recording available.";
    return;
  }

  const nameInput = document.getElementById("username").value.trim();
  const countryInput = document.getElementById("country").value.trim();
  const irishInput = document.getElementById("irish").value.trim();
  const safeUser = sanitizeName(nameInput || "anon");
  const safeCountry = sanitizeName(countryInput || "notstated");
  const safeIrish = sanitizeName(irishInput || "notstated");
  
  const passageName = State.variables.currentPassage || "unknown";
  const safePassage = sanitizeName(passageName);

  const filename = `${safeUser}_${safeCountry}_${safeIrish}_${safePassage}_${Date.now()}.webm`;

  console.log("Uploading:", filename);

  try {
    const storageRef = storage.ref("recordings/" + filename);
    const uploadTask = storageRef.put(currentBlob);

    uploadTask.on(
      "state_changed",
      snapshot => {
        const progress =
        (snapshot.bytesTransferred / snapshot.totalBytes) * 100;
      console.log("Upload is " + progress + "% done");
    },
    error => {
      console.error("Upload error:", error);
      document.getElementById("status").innerText =
        "Upload failed: " + error.message;
    },
    () => {
      console.log("Upload complete!");
      document.getElementById("status").innerText =
        "Upload complete!";
    }
);

    document.getElementById("status").innerText =
      "Upload complete!";

  } catch (err) {
    console.error(err);
    document.getElementById("status").innerText =
      "Upload failed: " + err.message;
  }
};

window.reRecord = function() {

  currentBlob = null;
  document.getElementById("preview").innerHTML = "";
  document.getElementById("controls").style.display = "none";
  document.getElementById("uploadBtn").disabled = true;
  document.getElementById("status").innerText =
    "Ready to record again";
};

:: StoryStylesheet [stylesheet]
body {
  font-size: 14px;  /* smaller text than default */
  line-height: 1.3; 
}


p {
  font-size: 14px;  /* smaller text than default */
  line-height: 1.3; 
  margin-top: 0.1em;
  margin-bottom: 0.1em;
}

.transcript {
  font-size: 20px;       /* make text larger */
  line-height: 1.4;      /* optional: spacing */
  font-weight: bold;     /* optional: make it bold */
  color: #333;           /* optional: change color */
}

#bgVideo {
  position: fixed;
  right: 0;
  bottom: 0;
  min-width: 100%;
  min-height: 100%
}

tw-story {
  background-color: #ffffff; /* white page background */
  color: black;              /* default text color */
  font-family: sans-serif;   /* optional, for readability */
  margin-top: 0;
}

tw-story tw-icon {
  color: black;               /* icon color */
  background-color: #eeeeee;  /* optional light background */
  border-radius: 4px;         /* optional rounded buttons */
  padding: 0.2em;             /* optional spacing */
  box-shadow: 0 0 2px rgba(0,0,0,0.3); /* subtle shadow */
}


/* Global passage styling to fill viewport */
tw-passage {
  min-height: 100vh;          /* full viewport height */
  width: 100%;                /* full width */
  box-sizing: border-box;     /* include padding inside element */
  padding: 2em;               /* space around text */
  color: black;               /* default text color */
  margin-top: 0;
}

/* Start page */
tw-passage[tags~="start"] {
  position: relative;
  min-height: 100vh;            /* ensures passage takes full viewport height */
  background-image: url("https://repository.dri.ie/objects/1v540035x/files/1z410w19m/download?type=surrogate");
  background-size: 100% auto;    /* stretch width to full viewport, keep aspect ratio */
  background-position: top center; /* align top of image */
  background-repeat: no-repeat;   /* don’t tile */
  background-color: white;        /* fills any extra space below the image */
  padding: 1.5em;                     /* internal text padding */
  border-radius: 10px;                /* slightly rounded corners */
}

