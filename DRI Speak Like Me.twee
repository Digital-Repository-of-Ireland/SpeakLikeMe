tw-passage[tags~="regular"] {
  position: relative; /* needed for pseudo-element positioning */
}

tw-passage[tags~="regular"]::before {
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(255,255,255,0.8); /* 70% white overlay */
  z-index: 0; /* behind the text */
}

tw-passage[tags~="regular"] * {
  position: relative; /* bring text above the overlay */
  z-index: 1;
}